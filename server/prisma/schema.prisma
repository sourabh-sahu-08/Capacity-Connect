generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String               @id @default(uuid())
  name                       String
  email                      String               @unique
  password                   String
  role                       String               @default("LEARNER")
  organization               String?
  avatar                     String?
  bio                        String?
  currentRole                String?
  targetRole                 String?
  learningGoal               String?
  experienceLevel            String?
  profileCompleted           Boolean              @default(false)
  learnerAssessmentCompleted Boolean              @default(false)
  trainerOnboardingCompleted Boolean              @default(false)
  resetPasswordToken         String?
  resetPasswordExpire        DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  
  assessments                Assessment[]
  competencyEvidences        CompetencyEvidence[]
  competencyProfile          CompetencyProfile?
  competencySnapshots        CompetencySnapshot[]
  courses                    Course[]
  insightEvents              InsightEvent[]
  notifications              Notification[]
  
  // New Relations
  enrollments                Enrollment[]
  assessmentAttempts         AssessmentAttempt[]
  lessonProgress             LessonProgress[]
  conversationsAsLearner     Conversation[]       @relation("LearnerConversations")
  conversationsAsTrainer     Conversation[]       @relation("TrainerConversations")
  messages                   Message[]
}

model Skill {
  id              String               @id @default(uuid())
  name            String
  slug            String               @unique
  category        String
  description     String
  parentSkillId   String?
  difficultyLevel Int
  organizationId  String?
  isActive        Boolean              @default(true)
  evidences       CompetencyEvidence[]
  profileSkills   ProfileSkill[]
  roleSkills      RoleSkill[]
  parentSkill     Skill?               @relation("SkillHierarchy", fields: [parentSkillId], references: [id])
  childSkills     Skill[]              @relation("SkillHierarchy")
  snapshots       SnapshotSkill[]
  courseSkills    CourseSkill[]
}

model RoleRequirement {
  id       String      @id @default(uuid())
  roleName String      @unique
  skills   RoleSkill[]
}

model RoleSkill {
  id                String          @id @default(uuid())
  roleRequirementId String
  skillId           String
  requiredLevel     Int
  importance        Float
  businessDemand    Float
  roleRequirement   RoleRequirement @relation(fields: [roleRequirementId], references: [id], onDelete: Cascade)
  skill             Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([roleRequirementId, skillId])
}

model CompetencyProfile {
  id               String         @id @default(uuid())
  userId           String         @unique
  overallScore     Float          @default(0)
  currentRole      String?
  targetRole       String?
  readinessScore   Float          @default(0)
  dnaTechnical     Float          @default(0)
  dnaAnalytical    Float          @default(0)
  dnaCommunication Float          @default(0)
  dnaLeadership    Float          @default(0)
  dnaCreativity    Float          @default(0)
  version          Int            @default(1)
  lastCalculatedAt DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           ProfileSkill[]
}

model ProfileSkill {
  id                  String            @id @default(uuid())
  competencyProfileId String
  skillId             String
  score               Float             @default(0)
  confidence          Float             @default(0)
  evidenceCount       Int               @default(0)
  lastUpdated         DateTime          @default(now())
  profile             CompetencyProfile @relation(fields: [competencyProfileId], references: [id], onDelete: Cascade)
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([competencyProfileId, skillId])
}

model CompetencyEvidence {
  id        String   @id @default(uuid())
  userId    String
  skillId   String
  source    String
  score     Float
  weight    Float
  metadata  Json?
  createdAt DateTime @default(now())
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CompetencySnapshot {
  id               String          @id @default(uuid())
  userId           String
  overallScore     Float
  dnaTechnical     Float?
  dnaAnalytical    Float?
  dnaCommunication Float?
  dnaLeadership    Float?
  dnaCreativity    Float?
  roleReadiness    Float
  trigger          String
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           SnapshotSkill[]
}

model SnapshotSkill {
  id                   String             @id @default(uuid())
  competencySnapshotId String
  skillId              String?
  score                Float?
  snapshot             CompetencySnapshot @relation(fields: [competencySnapshotId], references: [id], onDelete: Cascade)
  skill                Skill?             @relation(fields: [skillId], references: [id])
}

model InsightEvent {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  type           String
  title          String
  description    String
  metadata       Json?
  priority       String   @default("LOW")
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id                String    @id @default(uuid())
  recipientId       String
  role              String
  type              String
  title             String
  message           String
  priority          String    @default("LOW")
  category          String
  relatedEntityType String?
  relatedEntityId   String?
  actionUrl         String?
  isRead            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  readAt            DateTime?
  recipient         User      @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt(sort: Desc)])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// ECOSYSTEM MODELS (NEW/UPDATED)
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Course {
  id               String            @id @default(uuid())
  title            String
  description      String
  trainerId        String
  category         String?
  difficulty       String?
  duration         Int?              // in minutes
  thumbnail        String?
  status           String            @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  learningOutcomes Json?
  prerequisites    Json?
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  trainer          User              @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  courseSkills     CourseSkill[]
  modules          Module[]
  assessments      Assessment[]
  enrollments      Enrollment[]
  conversations    ConversationCourse[]
}

model CourseSkill {
  id            String   @id @default(uuid())
  courseId      String
  skillId       String
  importance    String   // LOW, MEDIUM, HIGH
  targetLevel   Int      // 0-100
  
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill         Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  @@unique([courseId, skillId])
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id          String   @id @default(uuid())
  moduleId    String
  title       String
  content     String?
  videoUrl    String?
  duration    Int?     // in minutes
  order       Int      @default(0)
  
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
}

model Enrollment {
  id             String    @id @default(uuid())
  learnerId      String
  courseId       String
  trainerId      String
  status         String    @default("ENROLLED") // ENROLLED, IN_PROGRESS, COMPLETED, DROPPED
  progress       Float     @default(0)
  enrolledAt     DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  lastActivityAt DateTime?
  
  learner        User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([learnerId, courseId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  learnerId   String
  lessonId    String
  courseId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  timeSpent   Int       @default(0) // in seconds
  
  learner     User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@unique([learnerId, lessonId])
}

model Assessment {
  id            String             @id @default(uuid())
  title         String
  description   String?
  courseId      String
  trainerId     String
  passingScore  Float              @default(70)
  availability  String             @default("AVAILABLE") // AVAILABLE, DRAFT, CLOSED
  questions     Json?
  skillMappings Json?
  
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer       User               @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  attempts      AssessmentAttempt[]
}

model AssessmentAttempt {
  id            String     @id @default(uuid())
  assessmentId  String
  learnerId     String
  courseId      String
  trainerId     String
  answers       Json?
  status        String     @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, UNDER_REVIEW, GRADED
  score         Float?
  feedback      String?
  
  submittedAt   DateTime?
  gradedAt      DateTime?
  gradedBy      String?    // User ID of trainer who graded
  
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  learner       User       @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// CHAT MODELS
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

model Conversation {
  id                 String               @id @default(uuid())
  learnerId          String
  trainerId          String
  lastMessagePreview String?
  lastMessageAt      DateTime?
  
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  
  learner            User                 @relation("LearnerConversations", fields: [learnerId], references: [id], onDelete: Cascade)
  trainer            User                 @relation("TrainerConversations", fields: [trainerId], references: [id], onDelete: Cascade)
  
  messages           Message[]
  relatedCourses     ConversationCourse[]
  
  @@unique([learnerId, trainerId])
}

model ConversationCourse {
  conversationId String
  courseId       String
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([conversationId, courseId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  type           String       @default("TEXT") // TEXT, SYSTEM
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  readAt         DateTime?
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
