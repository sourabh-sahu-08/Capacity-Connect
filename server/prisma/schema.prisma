generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String    @id @default(uuid())
  name                       String
  email                      String    @unique
  password                   String
  role                       String    @default("LEARNER")
  organization               String?
  
  avatar                     String?
  bio                        String?
  currentRole                String?
  targetRole                 String?
  learningGoal               String?
  experienceLevel            String?

  profileCompleted           Boolean   @default(false)
  learnerAssessmentCompleted Boolean   @default(false)
  trainerOnboardingCompleted Boolean   @default(false)
  resetPasswordToken         String?
  resetPasswordExpire        DateTime?

  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  competencyProfile          CompetencyProfile?
  competencyEvidences        CompetencyEvidence[]
  competencySnapshots        CompetencySnapshot[]
  insightEvents              InsightEvent[]
  notifications              Notification[]
  courses                    Course[]
  assessments                Assessment[]
}

model Skill {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  category         String
  description      String
  
  parentSkillId    String?
  parentSkill      Skill?    @relation("SkillHierarchy", fields: [parentSkillId], references: [id])
  childSkills      Skill[]   @relation("SkillHierarchy")

  difficultyLevel  Int
  organizationId   String?
  isActive         Boolean   @default(true)
  
  roleSkills       RoleSkill[]
  profileSkills    ProfileSkill[]
  evidences        CompetencyEvidence[]
  snapshots        SnapshotSkill[]
}

model RoleRequirement {
  id             String    @id @default(uuid())
  roleName       String    @unique
  
  skills         RoleSkill[]
}

model RoleSkill {
  id                String    @id @default(uuid())
  roleRequirementId String
  skillId           String
  requiredLevel     Int
  importance        Float
  businessDemand    Float

  roleRequirement   RoleRequirement @relation(fields: [roleRequirementId], references: [id], onDelete: Cascade)
  skill             Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([roleRequirementId, skillId])
}

model CompetencyProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  overallScore     Float     @default(0)
  
  currentRole      String?
  targetRole       String?
  readinessScore   Float     @default(0)

  dnaTechnical     Float     @default(0)
  dnaAnalytical    Float     @default(0)
  dnaCommunication Float     @default(0)
  dnaLeadership    Float     @default(0)
  dnaCreativity    Float     @default(0)

  version          Int       @default(1)
  lastCalculatedAt DateTime  @default(now())

  skills           ProfileSkill[]
}

model ProfileSkill {
  id                  String    @id @default(uuid())
  competencyProfileId String
  skillId             String
  
  score               Float     @default(0)
  confidence          Float     @default(0)
  evidenceCount       Int       @default(0)
  lastUpdated         DateTime  @default(now())

  profile             CompetencyProfile @relation(fields: [competencyProfileId], references: [id], onDelete: Cascade)
  skill               Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([competencyProfileId, skillId])
}

model CompetencyEvidence {
  id          String   @id @default(uuid())
  userId      String
  skillId     String
  source      String
  score       Float
  weight      Float
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

model CompetencySnapshot {
  id               String   @id @default(uuid())
  userId           String
  overallScore     Float
  
  dnaTechnical     Float?
  dnaAnalytical    Float?
  dnaCommunication Float?
  dnaLeadership    Float?
  dnaCreativity    Float?

  roleReadiness    Float
  trigger          String
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills           SnapshotSkill[]
}

model SnapshotSkill {
  id                   String             @id @default(uuid())
  competencySnapshotId String
  skillId              String?
  score                Float?

  snapshot             CompetencySnapshot @relation(fields: [competencySnapshotId], references: [id], onDelete: Cascade)
  skill                Skill?             @relation(fields: [skillId], references: [id], onDelete: SetNull)
}

model InsightEvent {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?
  type           String
  title          String
  description    String
  metadata       Json?
  priority       String   @default("LOW")
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id                String   @id @default(uuid())
  recipientId       String
  role              String
  type              String
  title             String
  message           String
  priority          String   @default("LOW")
  category          String
  relatedEntityType String?
  relatedEntityId   String?
  actionUrl         String?
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  readAt            DateTime?

  recipient         User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt(sort: Desc)])
}

model Course {
  id                 String   @id @default(uuid())
  title              String
  description        String
  trainerId          String
  status             String   @default("Active")
  targetCompetencies String[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  trainer            User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  assessments        Assessment[]
}

model Assessment {
  id          String   @id @default(uuid())
  title       String
  courseId    String
  trainerId   String
  type        String   @default("Project")
  maxScore    Float    @default(100)
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer     User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
}
